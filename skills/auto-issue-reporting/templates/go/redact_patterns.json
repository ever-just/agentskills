{"_comment":"RE2/JS/Python common subset: no lookaround, no inline flags, no named groups. flags: i = case-insensitive. repl: null means [REDACTED_<name>]. luhn: validate before replacing.",
 "rules":[
  {"name":"PRIVATE_KEY","flags":"","re":"-----BEGIN[ A-Z0-9_-]{0,100}PRIVATE KEY(?: BLOCK)?-----[\\s\\S]{16,}?-----END[ A-Z0-9_-]{0,100}PRIVATE KEY(?: BLOCK)?-----"},
  {"name":"AWS_KEY_ID","flags":"","re":"\\b(?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16}\\b"},
  {"name":"AWS_SECRET","flags":"i","re":"(aws_?secret_?access_?key|secretaccesskey)([\"']?\\s*[:=]\\s*[\"']?)[A-Za-z0-9/+=]{40}","repl":"${1}${2}[REDACTED_AWS_SECRET]"},
  {"name":"STRIPE_KEY","flags":"","re":"\\b[rs]k_(?:live|test|prod)_[A-Za-z0-9]{10,247}\\b"},
  {"name":"STRIPE_WHSEC","flags":"","re":"\\bwhsec_[A-Za-z0-9+/=_-]{16,}"},
  {"name":"GITHUB_TOKEN","flags":"","re":"\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,255}\\b"},
  {"name":"GITHUB_PAT","flags":"","re":"\\bgithub_pat_[A-Za-z0-9_]{36,255}\\b"},
  {"name":"SLACK_TOKEN","flags":"","re":"\\bxox(?:e\\.xox[bp]|[abeoprs])-[A-Za-z0-9-]{8,}"},
  {"name":"SLACK_APP_TOKEN","flags":"","re":"\\bxapp-\\d-[A-Za-z0-9-]{8,}"},
  {"name":"SLACK_WEBHOOK","flags":"","re":"hooks\\.slack\\.com/(?:services|workflows|triggers)/[A-Za-z0-9+/]{43,56}"},
  {"name":"JWT","flags":"","re":"\\bey[A-Za-z0-9_-]{17,}\\.ey[A-Za-z0-9_/-]{17,}\\.(?:[A-Za-z0-9_/-]{10,}={0,2})?"},
  {"name":"OPENAI_KEY","flags":"","re":"\\bsk-(?:(?:proj|svcacct|admin|service)-[A-Za-z0-9_-]{20,}|[A-Za-z0-9]{20})T3BlbkFJ[A-Za-z0-9_-]{20,}"},
  {"name":"ANTHROPIC_KEY","flags":"","re":"\\bsk-ant-[a-z]{2,8}\\d{2}-[A-Za-z0-9_-]{20,}"},
  {"name":"DEVIN_KEY","flags":"","re":"\\b(?:cog|apk_user|apk)_[A-Za-z0-9_-]{20,}"},
  {"name":"CLOUDFLARE_TOKEN","flags":"","re":"\\bcf(?:ut|at|k)_[A-Za-z0-9]{40}[a-f0-9]{8}\\b"},
  {"name":"CLOUDFLARE_LEGACY","flags":"i","re":"(cloudflare|cf_api_token|cf_api_key)([\\w.-]{0,20}[\"']?\\s*[:=]\\s*[\"']?)[A-Za-z0-9_-]{37,45}","repl":"${1}${2}[REDACTED_CLOUDFLARE]"},
  {"name":"SENTRY_TOKEN","flags":"","re":"\\bsntry[su]_[A-Za-z0-9+/=_]{64,}"},
  {"name":"OP_SA_TOKEN","flags":"","re":"\\bops_eyJ[A-Za-z0-9+/]{250,}={0,3}"},
  {"name":"DO_TOKEN","flags":"","re":"\\bdo[opr]_v1_[a-f0-9]{64}\\b"},
  {"name":"GCP_API_KEY","flags":"","re":"\\bAIza[A-Za-z0-9_-]{35}\\b"},
  {"name":"TWILIO_API_KEY","flags":"","re":"\\bSK[0-9a-fA-F]{32}\\b"},
  {"name":"URL_CREDENTIALS","flags":"i","re":"\\b([a-z][a-z0-9+.-]*://)[^\\s:/?#@]+:[^\\s@/]+@","repl":"${1}[REDACTED_USERINFO]@"},
  {"name":"DSN_PASSWORD","flags":"i","re":"\\b(password|passwd|pwd)=('[^']*'|[^\\s;&]+)","repl":"${1}=[REDACTED]"},
  {"name":"AUTH_HEADER","flags":"i","re":"\\b(bearer|basic|token)\\s+[A-Za-z0-9._~+/=-]{8,}","repl":"${1} [REDACTED]"},
  {"name":"SECRET_KV","flags":"i","re":"([\\w.-]{0,50}(?:access|auth|api|credential|creds|key|passw(?:or)?d|secret|token|session|cookie|signature)[\\w.-]{0,20}[\"']?\\s*(?:=|:|=>)\\s*[\"']?)[^\\s\"',;&]{8,}","repl":"${1}[REDACTED]"},
  {"name":"HEX40","flags":"","re":"\\b[a-f0-9]{40}\\b"},
  {"name":"EMAIL","flags":"","re":"\\b[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\\.[a-zA-Z0-9-]+)*\\.[a-zA-Z]{2,}\\b"},
  {"name":"CARD","flags":"","re":"\\b(?:\\d[ -]?){12,18}\\d\\b","luhn":true},
  {"name":"US_SSN","flags":"","re":"\\b[0-9]{3}-[0-9]{2}-[0-9]{4}\\b"},
  {"name":"PHONE_E164","flags":"","re":"\\+[1-9]\\d{6,14}\\b"},
  {"name":"PHONE_NANP","flags":"","re":"(?:\\+?1[\\s.-]?)?\\(?\\b[2-9]\\d{2}\\)?[\\s.-]?[2-9]\\d{2}[\\s.-]?\\d{4}\\b"},
  {"name":"IPV4","flags":"","re":"\\b(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\\.(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)){3}\\b"}
 ]}
